# --- Database ---
DATABASE_URL="postgresql://taskhunt:taskhunt@postgres:5432/taskhunt?schema=public"

# --- Redis (BullMQ / event bus) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Публичные URL нужны для OAuth callback'ов и редиректа после логина
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Payments ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# --- File storage (S3-compatible, e.g. Cloudflare R2) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Antivirus (ClamAV daemon) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

PORT=3001
NODE_ENV=development
