// ============================================================================
// TaskHunt — Prisma schema (apps/api)
//
// Единственный источник правды для денег — LedgerEntry/LedgerTransaction.
// Никаких прямых UPDATE баланса: любое движение денег — новая запись
// в леджере внутри БД-транзакции (см. WalletService).
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTH
// ============================================================================

enum MarketplaceRole {
  CLIENT
  FREELANCER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  GITHUB
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  oauthId      String?

  // выбирается на регистрации; пользователь может позже включить вторую роль
  // (стать ещё и фрилансером, если начинал как заказчик) — см. roles[]
  primaryRole MarketplaceRole
  roles       MarketplaceRole[] @default([])

  status  UserStatus @default(PENDING_VERIFICATION)
  isStaff Boolean    @default(false)

  // Единый активный токен на пользователя — новый запрос перетирает
  // старый (предыдущая ссылка перестаёт работать), проще чем отдельная
  // таблица токенов и достаточно для email-верификации/сброса пароля.
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?   @unique
  passwordResetExpiresAt     DateTime?

  // Двухфакторная аутентификация (TOTP) — см. TZ_CLAUDE_13.md, п.4
  totpSecret  String?
  totpEnabled Boolean          @default(false)
  backupCodes TotpBackupCode[]

  refreshSessions RefreshSession[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  profile    Profile?
  wallet     Wallet?
  onboarding OnboardingResponse?
  walletDeposits WalletDeposit[]

  ordersAsClient  Order[]  @relation("ClientOrders")
  bids            Bid[]
  reviewsAuthored Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  sentChatMessages        ChatMessage[]    @relation("ChatSender")
  chatThreadsAsFreelancer ChatThread[]     @relation("ChatThreadFreelancer")
  chatThreadReads         ChatThreadRead[]
  supportTickets          SupportTicket[]  @relation("TicketOwner")
  assignedTickets         SupportTicket[]  @relation("TicketAssignee")
  supportMessages         SupportMessage[]

  disputesOpened   Dispute[] @relation("DisputeOpener")
  disputesAssigned Dispute[] @relation("DisputeArbitrator")

  staffRoles UserStaffRole[]
  auditLogs  AuditLog[]

  referralCode ReferralCode?
  referredBy   ReferralUse?  @relation("ReferredUser")
  subscription Subscription?

  notificationPrefs   NotificationPreference[]
  notifications       Notification[]
  files               FileAsset[]
  payoutAddresses     SavedPayoutAddress[]
  savedOrders         SavedOrder[]
  savedSearches       SavedSearch[]
  savedFreelancers    SavedFreelancer[]
  savedByAsFreelancer SavedFreelancer[]        @relation("SavedFreelancerTarget")

  digestFrequency  DigestFrequency @default(NONE)
  lastDigestSentAt DateTime?

  endorsementsGiven    SkillEndorsement[] @relation("EndorsementAuthor")
  endorsementsReceived SkillEndorsement[] @relation("EndorsementTarget")

  sentInvites     OrderInvite[] @relation("OrderInviteClient")
  receivedInvites OrderInvite[] @relation("OrderInviteFreelancer")

  bidTemplates   BidTemplate[]
  orderTemplates OrderTemplate[]

  blocksCreated    ClientBlock[] @relation("ClientBlockOwner")
  blockedByClients ClientBlock[] @relation("ClientBlockTarget")

  fraudFlags         FraudFlag[] @relation("FraudFlagSubject")
  fraudFlagsReviewed FraudFlag[] @relation("FraudFlagReviewer")

  @@index([status])
  @@map("users")
}

enum DigestFrequency {
  NONE
  DAILY
  WEEKLY
}

model TotpBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("totp_backup_codes")
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@map("refresh_sessions")
}

// Профиль — публичные данные + то, что видно в карточке пользователя
model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName    String
  avatarUrl      String?
  avatarData     Bytes?
  avatarMimeType String?
  bio            String?
  country        String?
  city           String?
  githubUrl      String?
  websiteUrl     String?

  successRate      Decimal?  @db.Decimal(5, 2) // % успешных сделок
  completionRate   Decimal?  @db.Decimal(5, 2)
  avgResponseMins  Int?
  disputesCount    Int       @default(0)
  lateDeliveries   Int       @default(0)
  viewsCount       Int       @default(0)
  availableForWork Boolean   @default(true)
  vacationUntil    DateTime?

  skills         ProfileSkill[]
  portfolioItems PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Skill {
  id           String             @id @default(uuid())
  name         String             @unique
  slug         String             @unique
  profiles     ProfileSkill[]
  endorsements SkillEndorsement[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  skillId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

model PortfolioItem {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  projectUrl  String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
  @@map("portfolio_items")
}

model BidTemplate {
  id                  String   @id @default(uuid())
  freelancerId        String
  freelancer          User     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  name                String
  message             String
  defaultDeliveryDays Int?
  createdAt           DateTime @default(now())

  @@index([freelancerId])
  @@map("bid_templates")
}

// Анкета/квиз при регистрации — ответы различаются в зависимости от роли,
// поэтому большая часть хранится как гибкий JSON (structuredAnswers),
// а самые важные для матчинга поля вынесены в колонки.
model OnboardingResponse {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role                  MarketplaceRole
  experienceLevel       String? // junior/middle/senior — для фрилансера
  primaryGoal           String? // "найти исполнителя" / "найти подработку" / "нанять команду"
  interestedCategoryIds String[]        @default([])
  expectedBudgetMin     Decimal?        @db.Decimal(12, 2) // для клиента: типичный бюджет заказа
  expectedRateMin       Decimal?        @db.Decimal(12, 2) // для фрилансера: ожидаемая ставка
  availability          String? // full-time/part-time/occasional
  structuredAnswers     Json            @default("{}")

  completedAt DateTime @default(now())

  @@map("onboarding_responses")
}

// ============================================================================
// CATEGORIES (дерево, мультиниша)
// ============================================================================

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  parentId      String?
  parent        Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]    @relation("CategoryTree")
  orders        Order[]
  savedSearches SavedSearch[]
  orderTemplates OrderTemplate[]

  @@index([parentId])
  @@map("categories")
}

// ============================================================================
// ORDERS / BIDS / MILESTONES / VERSIONING
// ============================================================================

enum OrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
  DISPUTED
  EXPIRED
}

model Order {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation("ClientOrders", fields: [clientId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title       String
  description String
  budgetMin   Decimal   @db.Decimal(12, 2)
  budgetMax   Decimal?  @db.Decimal(12, 2)
  currency    String    @default("USD")
  deadline    DateTime?
  tags        String[]  @default([])

  status                OrderStatus @default(OPEN)
  acceptedBidId         String?     @unique
  viewsCount            Int         @default(0)
  deadlineWarningSentAt DateTime?

  bids                      Bid[]
  milestones                Milestone[]
  versions                  OrderVersion[]
  chatThreads               ChatThread[]
  deliveries                Delivery[]
  disputes                  Dispute[]
  invoices                  Invoice[]
  fraudFlags                FraudFlag[]
  savedBy                   SavedOrder[]
  skillEndorsements         SkillEndorsement[]
  invites                   OrderInvite[]
  deadlineExtensionRequests DeadlineExtensionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
  @@map("orders")
}

enum OrderInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model OrderInvite {
  id           String            @id @default(uuid())
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User              @relation("OrderInviteFreelancer", fields: [freelancerId], references: [id])
  clientId     String
  client       User              @relation("OrderInviteClient", fields: [clientId], references: [id])
  status       OrderInviteStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@unique([orderId, freelancerId])
  @@map("order_invites")
}

// "Избранное" — фрилансер откладывает заказ, чтобы вернуться к нему позже
// (аналог сохранённых вакансий на job-бордах), без привязки к отклику.
model SavedOrder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, orderId])
  @@map("saved_orders")
}

// Подписка на новые заказы по фильтру — при публикации подходящего
// заказа (см. SavedSearchMatcherListener) юзеру падает уведомление.
model SavedSearch {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  tags          String[]  @default([])
  minBudget     Decimal?  @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  lastMatchedAt DateTime?

  @@index([userId])
  @@index([categoryId])
  @@map("saved_searches")
}

model SavedFreelancer {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User     @relation("SavedFreelancerTarget", fields: [freelancerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, freelancerId])
  @@map("saved_freelancers")
}

// Хранит снапшот заказа при каждом значимом изменении — можно строить diff
model OrderVersion {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  editedById    String
  createdAt     DateTime @default(now())

  @@unique([orderId, versionNumber])
  @@map("order_versions")
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Bid {
  id           String @id @default(uuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User   @relation(fields: [freelancerId], references: [id])

  amount       Decimal   @db.Decimal(12, 2)
  deliveryDays Int
  message      String
  status          BidStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([freelancerId])
  @@map("bids")
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  DELIVERED
  APPROVED
  RELEASED
  DISPUTED
}

model Milestone {
  id       String          @id @default(uuid())
  orderId  String
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title    String
  amount   Decimal         @db.Decimal(12, 2)
  position Int // порядок этапа (Design -> Frontend -> Backend -> ...)
  status   MilestoneStatus @default(PENDING)
  dueDate  DateTime?

  invoices   Invoice[]
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("milestones")
}

// ============================================================================
// WALLET / LEDGER (double-entry) / ESCROW / INVOICES
// ============================================================================

enum BalanceType {
  MAIN // доступные средства
  ESCROW // заморожено в активной сделке
  LOCKED // заблокировано (спор, ручная проверка)
  WITHDRAWABLE // прошло холд-период, готово к выводу
  PENDING // ожидает подтверждения сети (крипто-депозит не подтверждён)
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  REFUND
  COMMISSION
  BONUS
  REFERRAL
  PROMO
  CHARGEBACK
}

model Wallet {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String @default("USD")

  // Денормализованный кэш баланса для быстрого чтения.
  // Источник правды — SUM(LedgerEntry), эти поля пересчитываются
  // в той же БД-транзакции, что и запись в леджер (см. WalletService.applyTransaction).
  mainBalance         Decimal @default(0) @db.Decimal(18, 8)
  escrowBalance       Decimal @default(0) @db.Decimal(18, 8)
  lockedBalance       Decimal @default(0) @db.Decimal(18, 8)
  withdrawableBalance Decimal @default(0) @db.Decimal(18, 8)
  pendingBalance      Decimal @default(0) @db.Decimal(18, 8)

  autoWithdrawThreshold Decimal? @db.Decimal(12, 2)
  autoWithdrawAddressId String?

  entries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model SavedPayoutAddress {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  network    String
  address    String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([userId, network, address])
  @@index([userId])
  @@map("saved_payout_addresses")
}

// Группа проводок, которая обязана балансироваться (сумма DEBIT == сумма CREDIT)
model LedgerTransaction {
  id            String                @id @default(uuid())
  type          LedgerTransactionType
  referenceType String // "ORDER" | "MILESTONE" | "INVOICE" | "WITHDRAWAL" | ...
  referenceId   String?
  description   String?
  createdById   String? // null = система
  entries       LedgerEntry[]
  createdAt     DateTime              @default(now())

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

// Одна проводка. Баланс кошелька = SUM(CREDIT) - SUM(DEBIT) по каждому balanceType.
model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id])
  balanceType   BalanceType
  direction     LedgerDirection
  amount        Decimal           @db.Decimal(18, 8)
  currency      String            @default("USD")
  createdAt     DateTime          @default(now())

  @@index([walletId, balanceType])
  @@map("ledger_entries")
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

// Инвойс/счёт, выставляемый прямо в чате заказа
// Пополнение кошелька пользователем через NOWPayments (не привязано к заказу,
// в отличие от Invoice — это просто "занести деньги на платформу").
model WalletDeposit {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("USD")
  status   InvoiceStatus @default(PENDING)

  nowPaymentsPaymentId String?   @unique
  payAddress           String?
  payAmount            Decimal?  @db.Decimal(18, 8)
  payCurrency          String?
  paidAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("wallet_deposits")
}

model Invoice {
  id          String     @id @default(uuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  issuedById  String // фрилансер
  payerId     String // заказчик
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  description String?
  status      InvoiceStatus @default(PENDING)

  nowPaymentsPaymentId String?   @unique
  payAddress           String?
  payAmount            Decimal?  @db.Decimal(18, 8)
  payCurrency          String?
  paidAt               DateTime?

  chatMessage ChatMessage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

// ============================================================================
// CHAT (по заказу) + SUPPORT CHAT
// ============================================================================

// Тред переписки конкретного заказчика с конкретным фрилансером по
// заказу — не один на заказ, а один на пару (order, freelancer), чтобы
// заказчик мог писать любому откликнувшемуся ещё до принятия отклика.
model ChatThread {
  id           String        @id @default(uuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User          @relation("ChatThreadFreelancer", fields: [freelancerId], references: [id])
  messages     ChatMessage[]
  reads        ChatThreadRead[]
  createdAt    DateTime      @default(now())

  @@unique([orderId, freelancerId])
  @@map("chat_threads")
}

model ChatThreadRead {
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime   @default(now())

  @@id([threadId, userId])
  @@index([userId, lastReadAt])
  @@map("chat_thread_reads")
}

enum ChatMessageType {
  TEXT
  FILE
  INVOICE
  SYSTEM
}

model ChatMessage {
  id       String     @id @default(uuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String
  sender   User       @relation("ChatSender", fields: [senderId], references: [id])

  type      ChatMessageType @default(TEXT)
  body      String?
  invoiceId String?         @unique
  invoice   Invoice?        @relation(fields: [invoiceId], references: [id])
  fileId    String?
  file      FileAsset?      @relation(fields: [fileId], references: [id])

  editedAt  DateTime?
  deletedAt DateTime? // soft delete — видно в audit log, не пропадает физически
  createdAt DateTime  @default(now())

  @@index([threadId])
  @@map("chat_messages")
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id           String  @id @default(uuid())
  userId       String
  user         User    @relation("TicketOwner", fields: [userId], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  // Тикет мог родиться из спора (openDispute) — тогда сторонам не нужно
  // заводить отдельное обращение, чтобы обсудить его с поддержкой; резолюшн
  // спора автоматически отписывается сюда же.
  disputeId String?  @unique
  dispute   Dispute? @relation(fields: [disputeId], references: [id])

  subject  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id])
  body      String
  fileId    String?
  file      FileAsset?    @relation(fields: [fileId], references: [id])
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

// ============================================================================
// FILES / DELIVERY
// ============================================================================

enum FileKind {
  IMAGE
  VIDEO
  ARCHIVE
  DOCUMENT
  EXECUTABLE
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

model FileAsset {
  id         String     @id @default(uuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id])
  url        String
  mimeType   String
  sizeBytes  Int
  kind       FileKind
  scanStatus ScanStatus @default(PENDING)
  // Снимает файл с /admin/moderation-queue после того, как модератор его
  // просмотрел — scanStatus остаётся фактом антивируса (не переписываем
  // его вручную), а это поле — только "уже разобрано человеком".
  moderatedAt DateTime?

  chatMessages    ChatMessage[]
  supportMessages SupportMessage[]
  deliveryFiles   DeliveryFile[]
  disputeFiles    DisputeFile[]

  createdAt DateTime @default(now())

  @@map("file_assets")
}

model Delivery {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestoneId   String?
  milestone     Milestone?     @relation(fields: [milestoneId], references: [id])
  submittedById String
  description   String
  notes         String?
  versionNumber Int            @default(1)
  files         DeliveryFile[]
  createdAt     DateTime       @default(now())

  @@index([orderId])
  @@map("deliveries")
}

model DeliveryFile {
  deliveryId String
  fileId     String
  delivery   Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  file       FileAsset @relation(fields: [fileId], references: [id])

  @@id([deliveryId, fileId])
  @@map("delivery_files")
}

// ============================================================================
// REVIEWS / DISPUTES
// ============================================================================

model Review {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  // Модерация (CodexTZ 017.017/021) — hiddenAt скрывает отзыв из публичного
  // профиля, moderatedAt снимает его с /admin/moderation-queue независимо
  // от решения (в т.ч. когда модератор оставил отзыв видимым).
  hiddenAt    DateTime?
  moderatedAt DateTime?

  @@unique([orderId, authorId])
  @@map("reviews")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CLIENT
  RESOLVED_FREELANCER
  RESOLVED_SPLIT
  CLOSED
}

model Dispute {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestoneId  String?
  openedById   String
  openedBy     User    @relation("DisputeOpener", fields: [openedById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("DisputeArbitrator", fields: [assignedToId], references: [id])

  reason          String
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?

  files         DisputeFile[]
  supportTicket SupportTicket?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@map("disputes")
}

// ============================================================================
// STAFF RBAC (granular permissions)
// ============================================================================

model StaffRole {
  id          String                @id @default(uuid())
  name        String                @unique // OWNER, SUPPORT, FINANCE, MODERATOR, ARBITRATOR, ANALYST, DEVELOPER...
  description String?
  permissions StaffRolePermission[]
  users       UserStaffRole[]

  @@map("staff_roles")
}

model Permission {
  id          String                @id @default(uuid())
  code        String                @unique // "escrow.release", "user.ban", "dispute.resolve", ...
  description String?
  roles       StaffRolePermission[]

  @@map("permissions")
}

model StaffRolePermission {
  roleId       String
  permissionId String
  role         StaffRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("staff_role_permissions")
}

model UserStaffRole {
  userId String
  roleId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_staff_roles")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String? // null = system
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // "ORDER_EDITED", "ESCROW_RELEASED", "MODERATOR_CHANGED_STATUS", ...
  targetType String // "Order", "Wallet", "Dispute", ...
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ============================================================================
// NOTIFICATIONS (только настройки; сама доставка — в notifications-service)
// ============================================================================

enum NotificationChannel {
  PUSH
  EMAIL
  TELEGRAM
  IN_APP
  SMS
}

model NotificationPreference {
  id      String              @id @default(uuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  enabled Boolean             @default(true)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

// ============================================================================
// REFERRALS / COMMISSIONS / FEATURE FLAGS
// ============================================================================

model ReferralCode {
  id        String        @id @default(uuid())
  ownerId   String        @unique
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code      String        @unique
  createdAt DateTime      @default(now())
  uses      ReferralUse[]

  @@map("referral_codes")
}

model ReferralUse {
  id               String       @id @default(uuid())
  referralCodeId   String
  referralCode     ReferralCode @relation(fields: [referralCodeId], references: [id])
  referredUserId   String       @unique
  referredUser     User         @relation("ReferredUser", fields: [referredUserId], references: [id])
  rewardLedgerTxId String?
  createdAt        DateTime     @default(now())

  @@map("referral_uses")
}

enum CommissionType {
  MARKETPLACE_FEE
  WITHDRAWAL_FEE
  REFERRAL_FEE
  PROMOTION_FEE
  DISPUTE_FEE
  PRIORITY_SUPPORT_FEE
}

// Настраиваемые из админки комиссии — не хардкодим % в коде
model CommissionRule {
  id          String         @id @default(uuid())
  type        CommissionType @unique
  percentage  Decimal?       @db.Decimal(5, 2)
  fixedAmount Decimal?       @db.Decimal(12, 2)
  active      Boolean        @default(true)
  updatedAt   DateTime       @updatedAt

  @@map("commission_rules")
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique // "AI_FRAUD_SCORING", "MILESTONES", "REFERRALS", ...
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  updatedAt      DateTime @updatedAt

  @@map("feature_flags")
}

enum SubscriptionTierName {
  STARTER
  PRO
  PREMIUM
}

model SubscriptionTier {
  id                      String               @id @default(uuid())
  name                    SubscriptionTierName @unique
  priceUsd                Decimal              @db.Decimal(8, 2)
  commissionPercent       Decimal              @db.Decimal(5, 2)
  maxActiveBidsPerMonth   Int?
  maxActiveOrdersPerMonth Int?
  freeBoostsPerMonth      Int                  @default(0)
  supportPriority         TicketPriority       @default(NORMAL)
  subscriptions           Subscription[]

  @@map("subscription_tiers")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
  tierId    String
  tier      SubscriptionTier   @relation(fields: [tierId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime
  invoiceId String?

  @@map("subscriptions")
}

enum PromotedEntityType {
  ORDER
  PROFILE
}

model Promotion {
  id            String             @id @default(uuid())
  entityType    PromotedEntityType
  entityId      String
  purchasedById String
  startedAt     DateTime           @default(now())
  expiresAt     DateTime
  amountUsd     Decimal?           @db.Decimal(8, 2)
  invoiceId     String?

  @@index([entityType, entityId])
  @@map("promotions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  eventName String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ============================================================================
// АНТИ-ФРОД — fraud-service скорит события асинхронно (своя изолированная
// БД, читает очередь доменных событий) и репортит результат сюда через
// внутренний вебхук (см. FraudController.receiveFlag в apps/api). Раньше
// вывод fraud-service нигде в основном апи не читался и не хранился — эта
// таблица и есть мост между асинхронным скорингом и админкой.
// ============================================================================

enum FraudFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudFlagStatus {
  OPEN
  REVIEWED
  DISMISSED
  CONFIRMED
}

model FraudFlag {
  id        String @id @default(uuid())
  eventName String // доменное событие, вызвавшее скоринг: 'OrderCreated', 'BidAccepted', ...

  userId  String?
  user    User?   @relation("FraudFlagSubject", fields: [userId], references: [id])
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  riskScore Int // 0-100, считает fraud-service
  severity  FraudFlagSeverity
  reasons   String[]          @default([])

  status       FraudFlagStatus @default(OPEN)
  reviewedById String?
  reviewedBy   User?           @relation("FraudFlagReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, severity])
  @@index([userId])
  @@index([orderId])
  @@map("fraud_flags")
}

model SkillEndorsement {
  id         String   @id @default(uuid())
  endorserId String
  endorser   User     @relation("EndorsementAuthor", fields: [endorserId], references: [id])
  targetId   String
  target     User     @relation("EndorsementTarget", fields: [targetId], references: [id])
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([endorserId, targetId, skillId, orderId])
  @@map("skill_endorsements")
}

model DisputeFile {
  disputeId String
  fileId    String
  dispute   Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  file      FileAsset @relation(fields: [fileId], references: [id])

  @@id([disputeId, fileId])
  @@map("dispute_files")
}

model DeadlineExtensionRequest {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy String
  newDeadline DateTime
  reason      String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@map("deadline_extension_requests")
}

model OrderTemplate {
  id          String   @id @default(uuid())
  clientId    String
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  title       String
  description String
  budgetMin   Decimal  @db.Decimal(12, 2)
  budgetMax   Decimal? @db.Decimal(12, 2)
  tags        String[] @default([])
  frequency   String
  nextRunAt   DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("order_templates")
}

model SearchLog {
  id        String   @id @default(uuid())
  query     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("search_logs")
}

model ClientBlock {
  id           String   @id @default(uuid())
  clientId     String
  client       User     @relation("ClientBlockOwner", fields: [clientId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User     @relation("ClientBlockTarget", fields: [freelancerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([clientId, freelancerId])
  @@map("client_blocks")
}
