# URL бэкенда (NestJS API) — публичная переменная, попадает в клиентский бандл.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Публичный URL самого фронтенда — используется в метатегах (canonical/OG),
# robots.txt, sitemap.xml и JSON-LD. В деве можно не задавать (в коде есть
# фолбэк на http://localhost:3000), в проде — обязателен, реальный домен.
NEXT_PUBLIC_WEB_URL=http://localhost:3050
