# URL бэкенда (NestJS API) — публичная переменная, попадает в клиентский бандл.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Публичный URL самого фронтенда — используется в метатегах (canonical/OG),
# robots.txt, sitemap.xml и JSON-LD. В деве можно не задавать (в коде есть
# фолбэк на http://localhost:3000), в проде — обязателен, реальный домен.
NEXT_PUBLIC_WEB_URL=http://localhost:3050

# Google Analytics 4 (Measurement ID, формат G-XXXXXXXXXX). Не задан — GA
# вообще не грузится (см. layout.tsx), это нормальный режим для дева.
# Когда задан — грузится через Google Consent Mode v2: по умолчанию
# analytics_storage запрещён, включается только явным согласием в баннере
# cookie (CookieConsent.tsx, "Принять всё").
NEXT_PUBLIC_GA_MEASUREMENT_ID=
